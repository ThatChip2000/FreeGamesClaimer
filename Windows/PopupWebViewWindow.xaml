<Window x:Class="FreeGamesClaimer.Windows.PopupWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Inicio de sesión / Verificación"
        Width="520"
        Height="640"
        MinWidth="380"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#11141B"
        Foreground="#E6EAF2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171C26" BorderBrush="#262E3D" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="🔒" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#4ADE80" FontSize="12" />
                <TextBlock x:Name="PopupAddressText"
                           Text="Cargando ventana segura..."
                           VerticalAlignment="Center"
                           Foreground="#B8C2D4"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="PopupBrowser" Grid.Row="1" DefaultBackgroundColor="#11141B" />
    </Grid>
</Window>
