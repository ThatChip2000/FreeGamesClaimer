<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FreeGamesClaimer</AssemblyName>
    <RootNamespace>FreeGamesClaimer</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Aplicación ligera con WebView2 para ver y reclamar juegos gratis temporales en Epic Games, Steam y GOG sin abrir launchers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

</Project>
